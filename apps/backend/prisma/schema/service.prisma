enum ServiceType {
  APPLICATION
  CRON
  STATIC
  DATABASE
}

enum ServiceStatus {
  CREATED
  BUILDING
  DEPLOYING
  RUNNING
  STOPPED
  FAILED
}

enum BuildType {
  DOCKER
  NATIVE
}

enum ServiceSource {
  GIT
  UPLOAD
  IMAGE
}

model Service {
  id        String        @id @default(ulid())
  name      String
  slug      String?
  type      ServiceType
  status    ServiceStatus @default(CREATED)
  buildType BuildType     @map("build_type")
  source    ServiceSource @default(GIT)

  repositoryUrl String? @map("repository_url")
  branch        String?
  archiveKey    String? @map("archive_key")
  imageRef      String? @map("image_ref")

  rootPath          String? @map("root_path")
  dockerfilePath    String? @map("dockerfile_path")
  dockerContextPath String? @map("docker_context_path")

  buildCommand   String? @map("build_command")
  startCommand   String? @map("start_command")
  advancedConfig Json?   @map("advanced_config")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId            String
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  domains              Domain[]
  deployments          Deployment[]
  environmentVariables EnvironmentVariable[]
  logs                 Log[]

  @@unique([projectId, slug])
  @@index([projectId])
}

enum DomainStatus {
  CREATED
  VERIFIED
  FAILED
}

model Domain {
  id     String       @id @default(ulid())
  host   String       @unique
  status DomainStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
}

enum DeploymentSource {
  MANUAL
  GIT
  RETRY
}

enum DeploymentStatus {
  QUEUED
  PREPARING
  BUILDING
  DEPLOYING
  RUNNING
  FAILED
  CANCELLED
}

model Deployment {
  id String @id @default(ulid())

  status DeploymentStatus @default(QUEUED)
  source DeploymentSource @default(MANUAL)

  branch     String?
  commitHash String? @map("commit_hash")

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime?
  error      String?

  attempt Int     @default(1)
  jobId   String? @map("job_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  logs      Log[]

  parentId String? @map("parent_id")
  parent   Deployment?  @relation("DeploymentRetry", fields: [parentId], references: [id])
  children Deployment[] @relation("DeploymentRetry")

  @@index([serviceId, createdAt])
  @@index([status])
}

enum EnvVarScope {
  RUNTIME
  BUILD
  BOTH
}

model EnvironmentVariable {
  id       String      @id @default(ulid())
  key      String
  value    String
  isSecret Boolean     @default(false) @map("is_secret")
  scope    EnvVarScope @default(RUNTIME)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, key])
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model Log {
  id        String   @id @default(ulid())
  message   String
  level     LogLevel
  timestamp DateTime @default(now())

  serviceId    String?
  service      Service?    @relation(fields: [serviceId], references: [id])
  deploymentId String?
  deployment   Deployment? @relation(fields: [deploymentId], references: [id])

  @@index([serviceId, timestamp])
  @@index([deploymentId, timestamp])
}
