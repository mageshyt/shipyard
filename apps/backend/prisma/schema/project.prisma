model Project {
  id          String   @id @default(ulid())
  name        String
  description String?
  ownerId     String
  slug        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([ownerId, slug])
  @@index([ownerId])
}
